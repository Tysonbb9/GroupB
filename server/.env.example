# Copy this file to server/.env and fill in the values from the Supabase
# dashboard (Project Settings > API Keys). server/.env is ignored by git.
# Leave both empty to run on the in-memory sample data instead.
#
# Never put these values in the client, in an EXPO_PUBLIC_ variable, in a
# test, a screenshot, an issue or a chat. The secret key bypasses every
# access rule in the database.

# The project URL. Not a secret; it is also in server/README.md.
SUPABASE_URL=
# The secret key (starts with sb_secret_). An older service_role key also works.
SUPABASE_SECRET_KEY=

# Login (US-21). All four can stay empty while developing: accounts are then
# kept in memory (lost on restart) and sessions use a development secret.
#
# Supabase's Postgres connection string (Dashboard > Connect), where accounts
# are saved. It holds the database password, so it is a secret too.
DATABASE_URL=
# A long random string that signs the sessions. Required in production.
# Make one with: npx auth secret
BETTER_AUTH_SECRET=
# The server's own address. Default http://localhost:3000.
BETTER_AUTH_URL=
# Expo Web's address, the only web page allowed to call the server with
# cookies. Default http://localhost:8081.
CLIENT_ORIGIN=
